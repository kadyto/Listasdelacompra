# Copia este archivo a .env y adapta las rutas y el UID/GID del sistema anfitrión.
# Por defecto, solo el sistema anfitrión accede al puerto: recomendado para Tailscale Serve.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3080
DATA_DIR=./data
BACKUP_DIR=./backups
APP_UID=1000
APP_GID=1000
# Normalmente vacío. Solo para un proxy privado que cambie Host;
# usa orígenes completos y exactos separados por comas, nunca un comodín.
ALLOWED_ORIGINS=
